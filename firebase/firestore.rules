rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function validSliitEmail(email) { return email is string && email.matches('^[^@\\s]+@my\\.sliit\\.lk$'); }

    match /student_allowlist/{studentId} {
      allow read, write: if isAdmin();
    }

    match /student_claims/{studentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/student_claims/$(studentId))
        && exists(/databases/$(database)/documents/student_allowlist/$(studentId))
        && request.resource.data.studentId == studentId
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /profiles/{uid} {
      allow read: if isAdmin() || own(uid);
      allow create: if own(uid)
        && request.resource.data.role == 'student'
        && request.resource.data.studentId is string
        && validSliitEmail(request.resource.data.sliitEmail)
        && request.resource.data.phone == request.auth.token.phone_number
        && request.resource.data.disabled == false
        && exists(/databases/$(database)/documents/student_allowlist/$(request.resource.data.studentId))
        && getAfter(/databases/$(database)/documents/student_claims/$(request.resource.data.studentId)).data.uid == uid;
      allow update: if isAdmin() || (own(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.sliitEmail == resource.data.sliitEmail
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.disabled == resource.data.disabled);
      allow delete: if isAdmin() || own(uid);
    }

    match /progress/{uid} {
      allow read, write: if isAdmin() || own(uid);
    }
  }
}
