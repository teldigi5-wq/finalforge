rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function verifiedEmail() { return signedIn() && request.auth.token.email_verified == true; }
    function approvedStudent(uid) {
      let profile = get(/databases/$(database)/documents/profiles/$(uid)).data;
      let studentId = profile.studentId;
      return verifiedEmail() && own(uid)
        && exists(/databases/$(database)/documents/profiles/$(uid))
        && profile.role == 'student'
        && profile.disabled == false
        && profile.sliitEmail == request.auth.token.email
        && exists(/databases/$(database)/documents/student_allowlist/$(studentId))
        && get(/databases/$(database)/documents/student_allowlist/$(studentId)).data.active == true
        && get(/databases/$(database)/documents/student_allowlist/$(studentId)).data.sliitEmail == request.auth.token.email
        && exists(/databases/$(database)/documents/student_claims/$(studentId))
        && get(/databases/$(database)/documents/student_claims/$(studentId)).data.uid == uid;
    }

    match /student_allowlist/{studentId} {
      allow read, write: if isAdmin();
    }

    match /pending_registrations/{uid} {
      // Created and maintained only by the trusted signup/restart backend.
      allow read, write: if false;
    }

    match /student_claims/{studentId} {
      allow read: if isAdmin() || (verifiedEmail() && resource.data.uid == request.auth.uid);
      // Account activation is now server-certified so a browser cannot bypass
      // the 20-minute pending-registration boundary by writing its own claim.
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /profiles/{uid} {
      allow read: if isAdmin() || (verifiedEmail() && own(uid));
      // New student profiles are created only by POST /api/activate-account.
      allow create: if false;
      allow update: if isAdmin() || (approvedStudent(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.sliitEmail == resource.data.sliitEmail
        && request.resource.data.disabled == resource.data.disabled
        && request.resource.data.emailVerified == resource.data.emailVerified
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt']));
      allow delete: if isAdmin();
    }

    match /progress/{uid} {
      allow read, write: if isAdmin() || approvedStudent(uid);
    }
  }
}
